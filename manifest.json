  "voices": [
    {
      "id": "omnivoice-clone",
      "language": "*",
      "display_name": "Speaker's own voice (cloned from the video)",
      "requires": [
        "voice_ref_audio",
        "voice_ref_text"
      ]
    },
    {
      "id": "omnivoice-woman",
      "language": "*",
      "display_name": "Woman"
    },
    {
      "id": "omnivoice-woman-low",
      "language": "*",
      "display_name": "Woman, lower voice"
    },
    {
      "id": "omnivoice-older-woman",
      "language": "*",
      "display_name": "Older woman"
    },
    {
      "id": "omnivoice-man",
      "language": "*",
      "display_name": "Man"
    },
    {
      "id": "omnivoice-man-deep",
      "language": "*",
      "display_name": "Man, deep voice"
    },
    {
      "id": "omnivoice-older-man",
      "language": "*",
      "display_name": "Older man"
    },
    {
      "id": "omnivoice-girl",
      "language": "*",
      "display_name": "Teenage girl"
    },
    {
