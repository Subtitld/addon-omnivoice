{
  "manifest_version": 1,
  "id": "omnivoice",
  "version": "26.11.2",
  "display_name": "OmniVoice (offline, voice clone, 646 languages, non-commercial)",
  "summary": "k2-fsa's OmniVoice speaks more than 600 languages, in the speaker's own voice cloned from the video, across languages, or in a voice designed from a few attributes. The 1.35 GB model downloads on first use and needs about 2.5 GB of memory; on a CPU each second of speech takes several seconds to make. Its weights are for non-commercial use only (CC BY-NC).",
  "author": "Subtitld",
  "homepage": "https://github.com/Subtitld/addon-omnivoice",
  "license": "Apache-2.0 (add-on, audio.cpp); CC BY-NC (OmniVoice model weights: non-commercial use only); MIT (ggml, cJSON, libyaml, utf8proc, llama.cpp's tokenizer)",
  "executable": "bin/omnivoice-addon",
  "protocol": 1,
  "startup_timeout_sec": 30,
  "platforms": [
    "linux",
    "macos",
    "windows",
    "haiku"
  ],
  "haiku_packages": [
    "python3.14"
  ],
  "tasks": [
    "tts.synthesize"
  ],
  "compute": "cpu",
  "accelerators": [
    "mps"
  ],
