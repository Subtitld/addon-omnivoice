      "language": "*",
      "display_name": "Teenage boy"
    },
    {
      "id": "omnivoice-child",
      "language": "*",
      "display_name": "Child"
    },
    {
      "id": "omnivoice-whisper",
      "language": "*",
      "display_name": "Whispering woman"
    },
    {
      "id": "omnivoice-described",
      "language": "*",
      "display_name": "Voice you describe (in Configure)"
    }
  ],
  "models": [
    {
      "id": "omnivoice",
      "display_name": "OmniVoice (8-bit)",
      "repo": "audio-cpp/audio.cpp-gguf",
      "revision": "33120a4cfdf0d56786db934a03a093d4675de938",
      "size_mb": 1288,
      "license": "CC BY-NC",
      "bundled": false,
      "default": true
    }
  ],
  "disk_required_mb": 1500,
  "ram_required_mb": 2560,
  "config_schema": {
    "fields": [
      {
        "key": "steps",
        "type": "int",
        "label": "Quality steps",
        "default": 16,
        "min": 8,
        "max": 32,
        "step": 1,
        "help": "Diffusion steps for each line. 16 is fast and keeps every word; OmniVoice's own default, 32, takes twice as long and comes a little closer to the speaker."
      },
      {
        "key": "cfg",
        "type": "number",
        "label": "Guidance",
        "default": 2.0,
        "min": 1.0,
        "max": 4.0,
        "step": 0.1,
        "help": "How closely the speech follows the text and the voice. OmniVoice's default is 2.0."
      },
      {
        "key": "threads",
        "type": "int",
        "label": "CPU threads",
        "default": 0,
        "min": 0,
        "max": 256,
        "step": 1,
        "help": "0 picks the performance cores on a CPU that also has efficiency cores, else one thread per core. Fewer leaves the computer more responsive while dubbing."
      },
      {
        "key": "voice_gender",
        "type": "select",
        "label": "Voice gender",
        "default": "",
        "options": [
          {
            "value": "",
            "label": "Any"
          },
          {
            "value": "male",
            "label": "Male"
          },
          {
            "value": "female",
            "label": "Female"
          }
        ],
        "help": "For the voice 'Voice you describe'."
      },
      {
        "key": "voice_age",
        "type": "select",
        "label": "Voice age",
        "default": "",
        "options": [
          {
            "value": "",
            "label": "Any"
          },
          {
            "value": "child",
            "label": "Child"
          },
          {
            "value": "teenager",
            "label": "Teenager"
          },
          {
            "value": "young adult",
            "label": "Young adult"
          },
          {
            "value": "middle-aged",
            "label": "Middle-aged"
          },
          {
            "value": "elderly",
            "label": "Elderly"
          }
        ],
        "help": "For the voice 'Voice you describe'."
      },
      {
        "key": "voice_pitch",
        "type": "select",
        "label": "Voice pitch",
        "default": "",
        "options": [
          {
            "value": "",
            "label": "Any"
          },
          {
            "value": "very low pitch",
            "label": "Very low pitch"
          },
          {
            "value": "low pitch",
            "label": "Low pitch"
          },
          {
            "value": "moderate pitch",
            "label": "Moderate pitch"
          },
          {
            "value": "high pitch",
            "label": "High pitch"
          },
          {
            "value": "very high pitch",
            "label": "Very high pitch"
          }
        ],
        "help": "For the voice 'Voice you describe'."
      },
      {
        "key": "voice_accent",
        "type": "select",
        "label": "Accent (English)",
        "default": "",
        "options": [
          {
            "value": "",
            "label": "Any"
          },
          {
            "value": "american accent",
            "label": "American accent"
          },
          {
            "value": "british accent",
            "label": "British accent"
          },
          {
            "value": "australian accent",
            "label": "Australian accent"
          },
          {
            "value": "canadian accent",
            "label": "Canadian accent"
          },
          {
            "value": "indian accent",
            "label": "Indian accent"
          },
          {
            "value": "chinese accent",
            "label": "Chinese accent"
          },
          {
            "value": "japanese accent",
            "label": "Japanese accent"
          },
          {
            "value": "korean accent",
            "label": "Korean accent"
          },
          {
            "value": "portuguese accent",
            "label": "Portuguese accent"
          },
          {
            "value": "russian accent",
            "label": "Russian accent"
          }
        ],
        "help": "For the voice 'Voice you describe': the accent it speaks English with."
      },
      {
        "key": "voice_whisper",
        "type": "bool",
        "default": false,
        "label": "Whisper",
        "help": "For the voice 'Voice you describe': whispered speech."
      },
      {
        "key": "voice_ref_audio",
        "type": "file",
        "label": "Fallback reference clip",
        "help": "Used by the speaker's own voice when Subtitld has no clip of the speaker to send: 3 to 15 seconds of one person speaking, WAV preferred."
      },
      {
        "key": "voice_ref_text",
        "type": "string",
        "label": "Fallback reference transcript",
        "help": "The exact words spoken in the fallback clip. OmniVoice needs them to clone the voice."
      }
    ]
  }
}
